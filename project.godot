config_version=5

[application]
config/name="Нижние своды"
config/description="Бесконечная прогулка среди сводов, колодцев и лестниц."
run/main_scene="res://world/main.tscn"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.047, 0.047, 0.043, 1)
config/features=PackedStringArray("4.7", "Forward Plus")

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=800
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
anti_aliasing/quality/screen_space_aa=1
scaling_3d/scale=1.0
environment/defaults/default_clear_color=Color(0.13, 0.14, 0.14, 1)
lights_and_shadows/directional_shadow/size=4096

[internationalization]
locale/fallback="ru"
locale/translations=PackedStringArray("res://i18n/en.po", "res://i18n/zh_Hans.po", "res://i18n/es.po", "res://i18n/pt_BR.po", "res://i18n/de.po", "res://i18n/ja.po", "res://i18n/fr.po", "res://i18n/pl.po", "res://i18n/ko.po")
