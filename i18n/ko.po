msgid "Нижние своды"
msgstr "지하 궁륭"

msgid "НИЖНИЕ\nСВОДЫ"
msgstr "지하\n궁륭"

msgid "Войти    ⏎"
msgstr "들어가기    ⏎"

msgid "WASD  —  идти      ·      Мышь  —  осмотреться      ·      Shift  —  бег      ·      Esc  —  пауза"
msgstr "WASD 이동   ·   마우스 둘러보기   ·   Shift 달리기   ·   Esc 일시 정지"

msgid "Пауза"
msgstr "일시 정지"

msgid "Продолжить"
msgstr "계속하기"

msgid "Чувствительность мыши"
msgstr "마우스 감도"

msgid "Громкость"
msgstr "전체 음량"

msgid "Свои шаги"
msgstr "내 발소리"

msgid "Выйти из игры"
msgstr "게임 종료"

msgid "Язык"
msgstr "언어"

msgid "Приливная цистерна"
msgstr "조수 저수조"

msgid "Обратная обсерватория"
msgstr "뒤집힌 천문대"

msgid "Машинный зал"
msgstr "기관실"

msgid "Колодец отливов"
msgstr "썰물 우물"

msgid "Архив мер и весов"
msgstr "도량형 기록관"

msgid "Звёздная камера"
msgstr "별의 방"

msgid "Ярусы колумбария"
msgstr "층층이 쌓인 납골당"

msgid "Собор над провалом"
msgstr "심연 위의 대성당"

msgid "Архив прибоя"
msgstr "파도의 기록관"

msgid "Сцена после звонка"
msgstr "종이 울린 뒤의 무대"

msgid "Двор карантина"
msgstr "격리 안뜰"

msgid "Канатная кладовая"
msgstr "밧줄 창고"

msgid "Каменные слушатели"
msgstr "귀 기울이는 석상들"

msgid "Шлюзовая палата"
msgstr "수문실"

msgid "Мансарды переписчиков"
msgstr "필경사들의 다락방"

msgid "Дом ткацких станков"
msgstr "베틀의 집"

msgid "Пересыльная станция"
msgstr "중계역"

msgid "Зал литейных форм"
msgstr "거푸집 전당"

msgid "Палата немых часов"
msgstr "침묵하는 시계의 방"

msgid "Обратный вокзал"
msgstr "뒤집힌 종착역"

msgid "Лес камертонов"
msgstr "소리굽쇠 숲"

msgid "Кладка великанов"
msgstr "거인의 알둥지"

msgid "Море меридианов"
msgstr "자오선의 바다"

msgid "Останки левиафана"
msgstr "레비아탄의 유해"

msgid "Раковина глубин"
msgstr "심해의 조가비"

msgid "Стеклянный фьорд"
msgstr "유리 피오르"

msgid "Чёрное солнце"
msgstr "검은 태양"

msgid "Жерло"
msgstr "화산의 아가리"

msgid "Сад медуз"
msgstr "해파리 정원"

msgid "Архипелаг спор"
msgstr "포자 군도"

msgid "Дождь из спутников"
msgstr "위성의 비"

msgid "Долина гейзеров"
msgstr "간헐천 계곡"

msgid "Бумажная гроза"
msgstr "종이 폭풍"

msgid "Лунная пасека"
msgstr "달의 양봉장"

msgid "Обычный режим"
msgstr "일반 모드"

msgid "Песочница"
msgstr "샌드박스"

msgid "Найди дверь с дневным светом."
msgstr "햇빛이 새어 나오는 문을 찾으세요."

msgid "Выход найден"
msgstr "출구를 찾았습니다"

msgid "Новая игра"
msgstr "새 게임"

msgid "В главное меню"
msgstr "메인 메뉴"

msgid "Завершить и выйти в меню"
msgstr "탐험을 끝내고 메뉴로"

msgid "Фонарщик погасил свет."
msgstr "점등원이 불을 껐습니다."

msgid "Звон заглушил шум сводов."
msgstr "종소리가 다른 소리를 덮었습니다."

msgid "Собиратель украл звук ваших шагов."
msgstr "수집가가 당신의 발소리를 훔쳤습니다."

msgid "Носильщики переложили на вас свой груз."
msgstr "짐꾼들이 당신에게 짐을 떠넘겼습니다."

msgid "Водолаз затопил ваш визор."
msgstr "잠수부가 당신의 안면창에 물을 채웠습니다."

msgid "Паломник вернул вас к началу."
msgstr "순례자가 당신을 출발점으로 돌려보냈습니다."

msgid "Рама перенесла вас в соседний зал."
msgstr "액자가 당신을 옆방으로 옮겼습니다."

msgid "Часовой велел замереть."
msgstr "파수꾼이 꼼짝 말라고 명령했습니다."

msgid "Писец забрызгал чернилами края обзора."
msgstr "서기가 뿌린 잉크가 시야 가장자리를 가렸습니다."

msgid "Веретено развернуло вас."
msgstr "물레가락이 당신의 몸을 돌려세웠습니다."

msgid "Янтарная печать защитит от одного касания."
msgstr "호박 인장이 거주민의 접촉을 한 번 막아 줍니다."

msgid "Печать раскололась и поглотила касание."
msgstr "인장이 깨지며 접촉의 효과를 흡수했습니다."

msgid "Песочные часы отогнали обитателей на 45 секунд."
msgstr "모래시계가 거주민들을 45초 동안 쫓아냈습니다."

msgid "Сложный режим"
msgstr "어려움 모드"

msgid "Размер карты"
msgstr "지도 크기"

msgid "Маленькая"
msgstr "소형"

msgid "Средняя"
msgstr "중형"

msgid "Большая"
msgstr "대형"

msgid "Здоровье"
msgstr "체력"

msgid "Тьма поглотила тебя"
msgstr "어둠에 삼켜졌다"

msgid "Найди дверь с дневным светом. Тьма за спиной отнимает здоровье, если вернуться на свой след."
msgstr "햇빛이 비치는 문을 찾으세요. 지나온 길에는 어둠이 깔립니다. 그 길을 다시 밟으면 체력이 줄어듭니다."
