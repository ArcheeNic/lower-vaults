msgstr "Inverted Terminus"

msgid "Лес камертонов"
msgstr "Forest of Tuning Forks"

msgid "Кладка великанов"
msgstr "The Giants’ Clutch"

msgid "Море меридианов"
msgstr "Sea of Meridians"

msgid "Останки левиафана"
msgstr "Remains of the Leviathan"

msgid "Раковина глубин"
msgstr "Shell of the Deep"

msgid "Стеклянный фьорд"
msgstr "Glass Fjord"

msgid "Чёрное солнце"
msgstr "Black Sun"

msgid "Жерло"
msgstr "The Maw"

msgid "Сад медуз"
msgstr "Jellyfish Garden"

msgid "Архипелаг спор"
msgstr "Archipelago of Spores"

msgid "Дождь из спутников"
msgstr "Rain of Satellites"

msgid "Долина гейзеров"
msgstr "Valley of Geysers"

msgid "Бумажная гроза"
msgstr "Paper Thunderstorm"

msgid "Лунная пасека"
msgstr "Lunar Apiary"

msgid "Обычный режим"
msgstr "Normal mode"

msgid "Песочница"
msgstr "Sandbox"

msgid "Найди дверь с дневным светом."
msgstr "Find the door with daylight behind it."

msgid "Выход найден"
msgstr "You found the exit"

msgid "Новая игра"
msgstr "New game"

msgid "В главное меню"
msgstr "Main menu"

msgid "Завершить и выйти в меню"
msgstr "End run and return to menu"

msgid "Фонарщик погасил свет."
msgstr "The Lamplighter put out the lights."

msgid "Звон заглушил шум сводов."
msgstr "The bell drowned out the sounds of the vaults."

msgid "Собиратель украл звук ваших шагов."
msgstr "The Collector stole the sound of your footsteps."

msgid "Носильщики переложили на вас свой груз."
msgstr "The Bearers passed their burden to you."

msgid "Водолаз затопил ваш визор."
msgstr "The Diver flooded your visor."

msgid "Паломник вернул вас к началу."
msgstr "The Pilgrim returned you to the start."

msgid "Рама перенесла вас в соседний зал."
msgstr "The Frame carried you into the next hall."

msgid "Часовой велел замереть."
msgstr "The Watchman ordered you to freeze."

msgid "Писец забрызгал чернилами края обзора."
msgstr "The Scribe splashed ink across the edges of your vision."

msgid "Веретено развернуло вас."
msgstr "The Spindle spun you around."

msgid "Янтарная печать защитит от одного касания."
msgstr "The amber seal will protect you from one touch."

msgid "Печать раскололась и поглотила касание."
msgstr "The seal shattered and absorbed the touch."

msgid "Песочные часы отогнали обитателей на 45 секунд."
msgstr "The hourglass has driven the inhabitants away for 45 seconds."

msgid "Сложный режим"
msgstr "Hard mode"

msgid "Размер карты"
msgstr "Map size"

msgid "Маленькая"
msgstr "Small"

msgid "Средняя"
msgstr "Medium"

msgid "Большая"
msgstr "Large"

msgid "Здоровье"
msgstr "Health"

msgid "Тьма поглотила тебя"
msgstr "The dark claimed you"

msgid "Найди дверь с дневным светом. Тьма за спиной отнимает здоровье, если вернуться на свой след."
msgstr "Find the daylight door. Darkness gathers behind you. Retracing your steps costs health."
