msgid "Код комнаты"
msgstr "Kod pokoju"

msgid "Войти по коду"
msgstr "Dołącz kodem"

msgid "Неверный код. Нужно шесть символов, например K7Q-2MX."
msgstr "Nieprawidłowy kod. Wpisz sześć znaków, na przykład K7Q-2MX."

