msgstr "度量衡の資料庫"

msgid "Звёздная камера"
msgstr "星の間"

msgid "Ярусы колумбария"
msgstr "納骨堂の段廊"

msgid "Собор над провалом"
msgstr "深淵に架かる大聖堂"

msgid "Архив прибоя"
msgstr "波しぶきの書庫"

msgid "Сцена после звонка"
msgstr "ベルが鳴りやんだ舞台"

