msgstr "Terminer la partie et revenir au menu"

msgid "Фонарщик погасил свет."
msgstr "L’allumeur a éteint les lumières."

msgid "Звон заглушил шум сводов."
msgstr "La cloche couvre les bruits des voûtes."

msgid "Собиратель украл звук ваших шагов."
msgstr "Le collectionneur a volé le bruit de vos pas."

msgid "Носильщики переложили на вас свой груз."
msgstr "Les porteurs vous ont confié leur fardeau."

msgid "Водолаз затопил ваш визор."
msgstr "Le scaphandrier a noyé votre visière."

msgid "Паломник вернул вас к началу."
msgstr "Le pèlerin vous a ramené au point de départ."

msgid "Рама перенесла вас в соседний зал."
msgstr "Le cadre vous a transporté dans la salle voisine."

msgid "Часовой велел замереть."
msgstr "La sentinelle vous a ordonné de rester immobile."

msgid "Писец забрызгал чернилами края обзора."
msgstr "Le scribe a éclaboussé d’encre les bords de votre champ de vision."

msgid "Веретено развернуло вас."
msgstr "Le fuseau vous a fait faire demi-tour."

msgid "Янтарная печать защитит от одного касания."
msgstr "Le sceau d’ambre te protégera du prochain contact."

msgid "Печать раскололась и поглотила касание."
msgstr "Le sceau s’est brisé et a absorbé le contact."

msgid "Песочные часы отогнали обитателей на 45 секунд."
msgstr "Le sablier a chassé les habitants pour 45 secondes."

